# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# OAuth Providers (get these from respective developer consoles)
GITHUB_ID=your_github_client_id
GITHUB_SECRET=your_github_client_secret
GOOGLE_ID=your_google_client_id
GOOGLE_SECRET=your_google_client_secret

# Meilisearch
NEXT_PUBLIC_MEILISEARCH_HOST=your_meilisearch_host_here
NEXT_PUBLIC_MEILISEARCH_PUBLIC_KEY=your_meilisearch_public_key_here
MEILISEARCH_API_KEY=your_meilisearch_private_api_key_here

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_access_token_here