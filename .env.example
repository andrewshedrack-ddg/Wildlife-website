# WildGuard Society - Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# FLASK CONFIGURATION
# =============================================================================
FLASK_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Generate a SEPARATE key for JWT
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=604800

# =============================================================================
# DATABASE
# =============================================================================
# Development: SQLite (auto-created)
DATABASE_URL=sqlite:///instance/wildguard.db

# Production: PostgreSQL (Azure Database for PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:5432/wildguard?sslmode=require

# =============================================================================
# REDIS (for caching, sessions, rate limiting)
# =============================================================================
# Development: not required
# REDIS_URL=redis://localhost:6379/0

# Production: Azure Cache for Redis
# REDIS_URL=rediss://:password@host:6380/0

# =============================================================================
# EMAIL (SendGrid)
# =============================================================================
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@wildguard.org
SENDGRID_FROM_NAME=WildGuard Society

# Alternative: AWS SES
# AWS_SES_REGION=us-east-1
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=

# Alternative: SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@wildguard.org

# =============================================================================
# PUSH NOTIFICATIONS (Web Push / VAPID)
# =============================================================================
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@wildguard.org

# =============================================================================
# AZURE (for deployment, Key Vault, etc.)
# =============================================================================
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=wildguard-rg
AZURE_LOCATION=eastus

# Azure Key Vault (for production secrets)
# AZURE_KEY_VAULT_URL=https://wildguard-kv.vault.azure.net/

# =============================================================================
# EXTERNAL APIs
# =============================================================================
# GBIF (Global Biodiversity Information Facility)
GBIF_API_URL=https://api.gbif.org/v1

# iNaturalist
INATURALIST_API_URL=https://api.inaturalist.org/v1

# Azure AI Vision (Image Analysis) — powers the real /api/scan identification
# endpoint. Get a free resource at https://portal.azure.com (AI + Machine
# Learning > Azure AI services multi-service account). Leave blank to use the
# on-device trained model instead.
AZURE_VISION_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com/
AZURE_VISION_KEY=

# TensorFlow.js MobileNet (CDN)
TFJS_MODEL_URL=https://cdn.jsdelivr.net/npm/@tensorflow-models/mobilenet

# =============================================================================
# FRONTEND (if using separate frontend build)
# =============================================================================
# NEXT_PUBLIC_API_URL=https://api.wildguard.org/api/v1
# NEXT_PUBLIC_WS_URL=wss://api.wildguard.org

# =============================================================================
# ADMIN BOOTSTRAP (used only on first run to create initial admin)
# =============================================================================
ADMIN_EMAIL=admin@wildguard.org
ADMIN_PASSWORD= # Generate strong password, will be hashed on first run